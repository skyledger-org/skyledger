# Copy this file to .env and fill in what you use. Never commit .env.
# With SAMPLE_MODE=true nothing below is needed: the app runs on cached data with no network.
# Non-secret defaults (thresholds, regions, model ids) live in config/skyledger.json and config/regions/.

# --- Runtime ---
SAMPLE_MODE=true
PORT=8000
# Region from config/regions/<id>.json, and reporting year (must be cached for that region)
SKYLEDGER_REGION=permian
# GHGRP_YEAR=2023

# --- Which AI provider runs the model calls ---
#   nightshift  Meterless Nightshift on this machine (default)
#   nvidia      NVIDIA's API directly (e.g. a hosted deployment)
#   none        no model calls; agents use their deterministic paths
AI_PROVIDER=nightshift

# --- Meterless Nightshift ---
# Base URL from Nightshift > Console. Inside Docker use http://host.docker.internal:8088/v1
# The runtime token is in %LOCALAPPDATA%\ai.meterless.runtime\proxy-token (Windows).
# The NVIDIA key stays inside Nightshift > Setup > Providers, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-nightshift-runtime-token-here
# Optional model overrides (defaults in config/skyledger.json):
# METERLESS_MODEL=meterless/auto
# METERLESS_MODEL_REASONING=nvidia/nemotron-3.5-lightning-30b-a3b
# METERLESS_MODEL_VISION=openrouter/nvidia/nemotron-3.5-super-vl:free

# --- NVIDIA API direct ---
# Needed when AI_PROVIDER=nvidia, and as the fallback for the image step when Nightshift 1.2.7
# refuses images (docs/METERLESS_VISION_ISSUE.md). Every other call goes through Nightshift.
NVIDIA_API_KEY=
# NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Zetaris (local install) ---
# API token: create it yourself in the Zetaris web UI (http://localhost:3000 > Management > API Tokens).
# Inside Docker use http://host.docker.internal:8888/api/v1.0
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-zetaris-api-key-here
# Table names default to the region file (config/regions/<id>.json > zetaris.tables)

# --- Run limits (defaults in config/skyledger.json > run) ---
# SKYLEDGER_LIVE_MAX_PLUMES=20
# SKYLEDGER_MODEL_CONCURRENCY=4

# --- Sign-off contracts ---
# HMAC secret for analyst sign-off. If unset, a random per-install key is created in logs/.signoff-secret.
SIGNOFF_SECRET=

# --- SEC EDGAR (only for `npm run cache`; SEC requires a contact email in the User-Agent) ---
SEC_USER_AGENT="SkyLedger your-email@example.com"
