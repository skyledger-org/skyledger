# Copy this file to .env and fill in the values. Never commit .env.

# --- Meterless Nightshift (primary AI provider, required by the Power rule) ---
# From Nightshift > Console (top right). If Nightshift runs on another machine, use its LAN address.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-nightshift-runtime-token-here
METERLESS_MODEL=meterless/auto

# --- Zetaris (local install) ---
# API key: create it yourself in the Zetaris web UI (http://localhost:3000), copy it once.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-zetaris-api-key-here
ZETARIS_USERNAME=your-zetaris-sign-in-email
ZETARIS_PASSWORD=your-zetaris-password

# --- SEC EDGAR (required User-Agent with contact email) ---
SEC_USER_AGENT="GroundTruth hackathon your-email@example.com"

# --- Optional fallbacks (off by default) ---
# The official guide keeps the NVIDIA key inside Nightshift's Providers tab.
# Fill these only if you want a secondary direct route.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# --- Runtime ---
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000
