# Copy this file to .env and fill in the values. Never commit .env.
# With SAMPLE_MODE=true nothing below is needed: the app runs on cached data with no network.

# --- Runtime ---
SAMPLE_MODE=true
PORT=8000

# --- Meterless Nightshift (primary AI provider, required by the Power rule) ---
# From Nightshift > Console (top right). Inside Docker use http://host.docker.internal:8088/v1
# The NVIDIA key stays inside Nightshift > Setup > Providers, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-nightshift-runtime-token-here
# Lanes: routing modes or the exact Nemotron model ids pinned in Nightshift (NIGHT > LANES)
METERLESS_MODEL=meterless/auto
METERLESS_MODEL_VISION=meterless/vision
METERLESS_MODEL_REASONING=meterless/deep

# --- Zetaris (local install) ---
# API key: create it yourself in the Zetaris web UI (http://localhost:3000 > Management > API Tokens).
# Inside Docker use http://host.docker.internal:8888/api/v1.0
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-zetaris-api-key-here
# Names of the registered sources (see docs/ZETARIS_SETUP.md)
ZETARIS_PLUMES_TABLE=skyledger.cm_sources
ZETARIS_FACILITIES_TABLE=skyledger.ghgrp_facilities
ZETARIS_CH4_TABLE=skyledger.ghgrp_ch4

# --- SEC EDGAR (only for `npm run cache`; SEC requires a contact email in the User-Agent) ---
SEC_USER_AGENT="SkyLedger hackathon your-email@example.com"

# --- Sign-off contracts (HMAC secret; any long random string) ---
SIGNOFF_SECRET=change-me-to-a-long-random-string
