  },
  "homepage": "https://github.com/skyledger-org/skyledger#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22"
  }
